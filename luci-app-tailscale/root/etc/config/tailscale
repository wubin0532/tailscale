config settings 'settings'
	option enabled '0'
	option port '41641'
	option state_file '/etc/tailscale/tailscaled.state'
	option accept_routes '0'
	option hostname ''
	option auth_key ''
	option login_server ''
	option ssh '0'
	option advertise_exit_node '0'
	option exit_node ''
	option exit_allow_lan '1'
	list advertise_routes ''

config firewall 'auto'
	option enabled '0'
	option input 'ACCEPT'
	option lan_forward '1'
	option masq '1'
	list ports ''
