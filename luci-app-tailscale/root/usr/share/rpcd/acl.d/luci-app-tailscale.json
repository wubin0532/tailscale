{
	"luci-app-tailscale": {
		"description": "Grant UCI access for luci-app-tailscale",
		"read": {
			"ubus": {
				"tailscale": [ "get_status", "get_log", "get_netcheck", "ping" ]
			},
			"uci": [ "tailscale", "network" ]
		},
		"write": {
			"ubus": {
				"tailscale": [ "login", "logout", "uninstall" ],
				"luci": [ "setInitAction" ]
			},
			"uci": [ "tailscale" ]
		}
	}
}
